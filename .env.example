# Server Configuration
PORT=3000
HOST=localhost
# Optional deployment identifier, visible in /api/health and notification logs
APP_REVISION=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Database
# Optional override; blank uses ./data/monitor.sqlite (mount /app/data in Docker)
MONITOR_DB_PATH=

# Email Notification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Website Monitor <your-email@gmail.com>

# Discord Webhook (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Slack Webhook (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Lark Custom Bot Webhook (Optional)
Lark_URL_API=

# Default Check Interval (milliseconds)
DEFAULT_CHECK_INTERVAL=30000

# Response Timeout (milliseconds)
REQUEST_TIMEOUT=10000
